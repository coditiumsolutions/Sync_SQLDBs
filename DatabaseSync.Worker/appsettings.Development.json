{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    }
  },
  "SyncSettings": {
    "SyncIntervalSeconds": 30,
    "EnableSynchronization": false,
    "RetryIntervalSeconds": 10,
    "MaximumRetryAttempts": 2,
    "EnableDetailedLogging": true
  }
}
