@inject DatabaseSync.Core.Interfaces.ISyncConfigStore ConfigStore
@{
    var path = Context.Request.Path.Value ?? "/";
    string Here(string prefix) =>
        path.Equals(prefix, StringComparison.OrdinalIgnoreCase) ||
        (prefix != "/" && path.StartsWith(prefix, StringComparison.OrdinalIgnoreCase))
            ? "is-here"
            : "";
    var desk = path is "/" or "/Index" ? "is-here" : "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Coditium Sync Desk</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<partial name="_IconSprites" />
<div class="sheet">
    <header class="mast">
        <a class="brand" asp-page="/Index">
            <span class="brand-kicker">Coditium</span>
            <span class="brand-name">Sync desk</span>
        </a>
        <nav class="nav-links">
            <a class="@desk" asp-page="/Index">
                <partial name="_Icon" model='"desk"' />
                <span>Desk</span>
            </a>
            <a class="@Here("/Connections")" asp-page="/Connections/Index">
                <partial name="_Icon" model='"connections"' />
                <span>Connections</span>
            </a>
            <a class="@Here("/Settings")" asp-page="/Settings">
                <partial name="_Icon" model='"triggers"' />
                <span>Triggers</span>
            </a>
            <a class="@Here("/Conflicts")" asp-page="/Conflicts">
                <partial name="_Icon" model='"conflicts"' />
                <span>Conflicts</span>
            </a>
        </nav>
    </header>
    @if (TempData["StatusMessage"] is string status && !string.IsNullOrWhiteSpace(status))
    {
        <div class="alert alert-success" role="status">
            <partial name="_Icon" model='"check"' />
            <span>@status</span>
        </div>
    }
    @if (TempData["ErrorMessage"] is string error && !string.IsNullOrWhiteSpace(error))
    {
        <div class="alert alert-danger" role="alert">
            <partial name="_Icon" model='"x"' />
            <span>@error</span>
        </div>
    }
    <main>
        @RenderBody()
    </main>
    <footer class="colophon">
        <span>One config file drives this desk and the worker.</span>
        <code>@ConfigStore.ConfigFilePath</code>
    </footer>
</div>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
