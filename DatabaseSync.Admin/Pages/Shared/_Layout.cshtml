@using DatabaseSync.Admin.Services
@inject ActiveInstanceInfo ActiveInstance
@{
    ActiveInstance.Refresh();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Coditium Database Sync Admin</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<header class="app-header">
    <div class="container d-flex align-items-center justify-content-between py-3">
        <a class="brand" asp-page="/Index">Coditium Sync Admin</a>
        <nav class="nav-links d-flex align-items-center flex-wrap">
            <a asp-page="/Projects/Index">Synchronization</a>
            <a asp-page="/Connections/Index">Servers</a>
            <a asp-page="/Instances">Databases</a>
            <a asp-page="/Index">Dashboard</a>
            <div class="dropdown d-inline-block">
                <a class="dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                    Other Actions
                </a>
                <ul class="dropdown-menu dropdown-menu-end nav-dropdown-menu">
                    <li><a class="dropdown-item" asp-page="/Tables">Tables</a></li>
                    <li><a class="dropdown-item" asp-page="/Settings">Settings</a></li>
                    <li><a class="dropdown-item" asp-page="/History">History</a></li>
                    <li><a class="dropdown-item" asp-page="/Summary">Summary</a></li>
                    @if (User.IsInRole("Admin"))
                    {
                        <li><a class="dropdown-item" asp-page="/Users">Users</a></li>
                    }
                </ul>
            </div>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <div class="dropdown d-inline-block">
                    <a class="dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                        @User.Identity.Name
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end nav-dropdown-menu">
                        <li><a class="dropdown-item" asp-page="/Logout">Logout</a></li>
                    </ul>
                </div>
            }
        </nav>
    </div>
</header>
<main class="container py-4">
    @if (User.Identity?.IsAuthenticated == true)
    {
        <div class="panel mb-3 active-instance-banner">
            <div class="d-flex align-items-center justify-content-between gap-2 flex-wrap">
                <div class="h5 mb-0">
                    @if (!string.IsNullOrWhiteSpace(ActiveInstance.Name))
                    {
                        <text>Active Database - @ActiveInstance.Name</text>
                    }
                    else
                    {
                        <span class="text-muted">Active Database - None</span>
                    }
                </div>
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <form method="post" asp-page="/Index" asp-page-handler="TestAll" class="d-inline">
                        <button type="submit" class="btn btn-sm btn-outline-secondary">Test all connections</button>
                    </form>
                    <a class="btn btn-sm btn-outline-secondary" asp-page="/Instances">Manage databases</a>
                </div>
            </div>
        </div>
    }
    @if (TempData["StatusMessage"] is string status && !string.IsNullOrWhiteSpace(status))
    {
        <div class="alert alert-success">@status</div>
    }
    @if (TempData["ErrorMessage"] is string error && !string.IsNullOrWhiteSpace(error))
    {
        <div class="alert alert-danger">@error</div>
    }
    @RenderBody()
</main>
<footer class="container py-4 text-muted small">
    Shared config file drives both the Admin UI and the Windows Worker service.
</footer>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
