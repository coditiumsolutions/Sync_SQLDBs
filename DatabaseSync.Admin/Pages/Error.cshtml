@page
@model ErrorModel
@{
    ViewData["Title"] = "Error";
}

<p class="eyebrow"><partial name="_Icon" model='"alert"' /> Desk</p>
<h1>Something broke</h1>
<p class="lede">The page did not finish. The sync config was not changed by this error.</p>

@if (Model.ShowRequestId)
{
    <p class="hint">Request <span class="mono">@Model.RequestId</span></p>
}

<p style="margin-top:1rem">
    <a class="icon-btn" asp-page="/Index">
        <partial name="_Icon" model='"desk"' />
        <span>Back to the desk</span>
    </a>
</p>
