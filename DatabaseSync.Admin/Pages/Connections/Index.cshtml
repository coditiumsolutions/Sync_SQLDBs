@page
@model DatabaseSync.Admin.Pages.Connections.IndexModel
@{
    ViewData["Title"] = "Connections";
}

<div class="page-head">
    <div>
        <p class="eyebrow">Topology</p>
        <h1>Connections</h1>
        <p class="lede">One connection is Main. Every other enabled connection is a target. Main's rows win.</p>
    </div>
    <div class="split-actions">
        <form method="post" asp-page-handler="TestAll">
            <button type="submit" class="btn-ghost">Test enabled</button>
        </form>
        <a class="btn-ink" asp-page="./Edit">Add connection</a>
    </div>
</div>

@if (Model.Connections.Count == 0)
{
    <p class="empty">No connections yet.</p>
}
else
{
    <table class="ledger-table">
        <thead>
        <tr>
            <th>Name</th>
            <th>Role</th>
            <th>Server / database</th>
            <th>Enabled</th>
            <th></th>
        </tr>
        </thead>
        <tbody>
        @foreach (var connection in Model.Connections)
        {
            <tr class="@(connection.IsEnabled ? null : "is-disabled")">
                <td><strong>@connection.Name</strong></td>
                <td>
                    @if (connection.IsMain)
                    {
                        <span class="pill on">Main</span>
                    }
                    else
                    {
                        <span class="pill off">Target</span>
                    }
                </td>
                <td class="mono">@connection.Server / @connection.Database</td>
                <td>
                    <form method="post" asp-page-handler="SetEnabled" class="enable-form">
                        <input type="hidden" name="id" value="@connection.Id" />
                        <input type="hidden" name="enabled" value="@(connection.IsEnabled ? "true" : "false")" class="enabled-value" />
                        <label class="arm arm-compact">
                            <input type="checkbox"
                                   checked="@connection.IsEnabled"
                                   onchange="this.form.querySelector('.enabled-value').value = this.checked ? 'true' : 'false'; this.form.submit();"
                                   aria-label="@(connection.IsEnabled ? $"Disable {connection.Name}" : $"Enable {connection.Name}")" />
                            <span class="arm-ui" aria-hidden="true"></span>
                            <span class="hint">@(connection.IsEnabled ? "On" : "Off")</span>
                        </label>
                    </form>
                </td>
                <td>
                    <div class="row-actions">
                        <a class="text-btn" asp-page="./Edit" asp-route-id="@connection.Id">Edit</a>
                        <form method="post" asp-page-handler="Test">
                            <input type="hidden" name="id" value="@connection.Id" />
                            <button class="text-btn" type="submit">Test</button>
                        </form>
                        @if (!connection.IsMain)
                        {
                            <form method="post" asp-page-handler="SetMain">
                                <input type="hidden" name="id" value="@connection.Id" />
                                <button class="text-btn" type="submit">Make main</button>
                            </form>
                        }
                        <form method="post" asp-page-handler="Delete" onsubmit="return confirm('Delete this connection?');">
                            <input type="hidden" name="id" value="@connection.Id" />
                            <button class="text-btn danger" type="submit">Delete</button>
                        </form>
                    </div>
                </td>
            </tr>
        }
        </tbody>
    </table>
}
