@page "{id?}"
@model DatabaseSync.Admin.Pages.Connections.EditModel
@{
    ViewData["Title"] = Model.IsNew ? "Add connection" : "Edit connection";
}

<form method="post">
    <div class="form-head">
        <div>
            <p class="eyebrow"><partial name="_Icon" model='"connections"' /> Topology</p>
            <h1>@ViewData["Title"]</h1>
        </div>
        <div class="split-actions">
            <a class="btn-ghost" asp-page="./Index">
                <partial name="_Icon" model='"x"' />
                <span>Cancel</span>
            </a>
            <button type="submit" class="btn-ink">
                <partial name="_Icon" model='"save"' />
                <span>Save</span>
            </button>
        </div>
    </div>
    <input type="hidden" asp-for="Input.Id" />

    <section class="section">
        <p class="eyebrow"><partial name="_Icon" model='"identity"' /> Identity</p>
        <div class="grid-2">
            <div class="field">
                <label class="line-label" asp-for="Input.Name"></label>
                <input asp-for="Input.Name" class="line" />
                <span asp-validation-for="Input.Name" class="field-validation-error"></span>
            </div>
            <div>
                <label class="check">
                    <input asp-for="Input.IsMain" />
                    <span><partial name="_Icon" model='"star"' /> Nominate as Main</span>
                </label>
                <label class="check">
                    <input asp-for="Input.IsEnabled" />
                    <span><partial name="_Icon" model='"check"' /> Enabled</span>
                </label>
            </div>
        </div>
    </section>

    <section class="section">
        <p class="eyebrow"><partial name="_Icon" model='"endpoint"' /> Endpoint</p>
        <div class="grid-2">
            <div class="field">
                <label class="line-label" asp-for="Input.Server"></label>
                <input asp-for="Input.Server" class="line" placeholder="Hostname" />
                <span asp-validation-for="Input.Server" class="field-validation-error"></span>
            </div>
            <div class="field">
                <label class="line-label" asp-for="Input.Database"></label>
                <input asp-for="Input.Database" class="line" />
                <span asp-validation-for="Input.Database" class="field-validation-error"></span>
            </div>
        </div>
        <div class="field" style="max-width:12rem">
            <label class="line-label" asp-for="Input.ConnectionTimeoutSeconds"></label>
            <input asp-for="Input.ConnectionTimeoutSeconds" class="line" />
        </div>
    </section>

    <section class="section">
        <p class="eyebrow"><partial name="_Icon" model='"auth"' /> Authentication</p>
        <label class="check">
            <input asp-for="Input.IntegratedSecurity" />
            <span>Windows authentication</span>
        </label>
        <div class="grid-2">
            <div class="field">
                <label class="line-label" asp-for="Input.UserId"></label>
                <input asp-for="Input.UserId" class="line" />
            </div>
            <div class="field">
                <label class="line-label" asp-for="Input.Password"></label>
                <input asp-for="Input.Password" class="line" autocomplete="new-password" />
                <p class="hint">Leave blank when editing to keep the existing password.</p>
            </div>
        </div>
        <label class="check">
            <input asp-for="Input.Encrypt" />
            <span>Encrypt</span>
        </label>
        <label class="check">
            <input asp-for="Input.TrustServerCertificate" />
            <span>Trust server certificate</span>
        </label>
    </section>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
