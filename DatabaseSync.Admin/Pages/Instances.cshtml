@page
@model DatabaseSync.Admin.Pages.InstancesModel
@{
    ViewData["Title"] = "Databases";
}

<div class="mb-3 d-flex align-items-start justify-content-between gap-3 flex-wrap">
    <div>
        <h1 class="h3 mb-1">Databases</h1>
        <div class="form-hint mb-0">
            Run <strong>one database at a time</strong> on shared port <strong>@Model.SharedPort</strong>
            (<code>@Model.SharedAdminUrl</code>).
            Starting a database stops any other running database first.
        </div>
    </div>
    <button type="button" class="btn btn-accent" data-bs-toggle="modal" data-bs-target="#addInstanceModal">Add database</button>
</div>

@if (Model.Editing is not null)
{
    <div class="panel mb-3">
        <h2 class="h5 mb-3">Edit database</h2>
        <form method="post" asp-page-handler="Edit" class="row g-3">
            <input type="hidden" asp-for="OriginalName" />
            <div class="col-md-4">
                <label class="form-label" asp-for="Name">Name</label>
                <input class="form-control" asp-for="Name" required pattern="[A-Za-z0-9_\-]+" />
                <div class="form-hint">Rename moves the instance folder. Stop the instance before renaming.</div>
            </div>
            <div class="col-md-5">
                <label class="form-label" asp-for="DatabaseHint">Database Hint</label>
                <input class="form-control" asp-for="DatabaseHint" />
                <div class="form-hint">Also updates Database on connections in sync-config when possible.</div>
            </div>
            <div class="col-md-3 d-flex align-items-end gap-2">
                <button type="submit" class="btn btn-accent">Save</button>
                <a class="btn btn-outline-secondary" asp-page="/Instances">Cancel</a>
            </div>
        </form>
        @if (!Model.Editing.IsCurrent)
        {
            <hr />
            <form method="post" asp-page-handler="Delete" class="d-inline"
                  onsubmit="return confirm('Delete instance @Model.Editing.Name? This removes its folder and config.');">
                <input type="hidden" name="Name" value="@Model.Editing.Name" />
                <button type="submit" class="btn btn-sm btn-outline-danger">Delete this instance</button>
            </form>
        }
    </div>
}

<div class="panel">
    @if (Model.Instances.Count == 0)
    {
        <p class="mb-0 text-muted">No databases yet. Click <strong>Add database</strong> to create one.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                <tr>
                    <th>Database</th>
                    <th>Database Hint</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var i in Model.Instances)
                {
                    <tr class="@(i.IsRunning ? "table-success" : "")">
                        <td>
                            <strong>@i.Name</strong>
                            @if (i.IsRunning)
                            {
                                <span class="badge-main ms-1">Active Database</span>
                            }
                        </td>
                        <td>@i.DatabaseHint</td>
                        <td>
                            @if (i.IsRunning)
                            {
                                <span>Active Database - <strong>@i.Name</strong></span>
                            }
                            else
                            {
                                <span class="text-muted">Stopped</span>
                            }
                        </td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-sm btn-outline-secondary" asp-page="/Instances" asp-route-edit="@i.Name">Edit</a>

                            @if (!i.IsCurrent)
                            {
                                <form method="post" asp-page-handler="Delete" class="d-inline"
                                      onsubmit="return confirm('Delete instance @i.Name? This removes its folder and config.');">
                                    <input type="hidden" name="Name" value="@i.Name" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                </form>
                            }

                            @if (i.IsRunning)
                            {
                                <form method="post" asp-page-handler="Stop" class="d-inline">
                                    <input type="hidden" name="Name" value="@i.Name" />
                                    <button type="submit" class="btn btn-sm btn-outline-secondary"
                                            onclick="return confirm('Stop @i.Name?');">Stop</button>
                                </form>
                            }
                            else
                            {
                                <form method="post" asp-page-handler="Start" class="d-inline">
                                    <input type="hidden" name="Name" value="@i.Name" />
                                    <button type="submit" class="btn btn-sm btn-accent"
                                            onclick="return confirm('Start @i.Name on port @Model.SharedPort? Any other instance will be stopped.');">Start</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>

<div class="modal fade" id="addInstanceModal" tabindex="-1" aria-labelledby="addInstanceLabel" aria-hidden="true">
    <div class="modal-dialog">
        <form method="post" asp-page-handler="Add" class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="addInstanceLabel">Add database</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label" for="addName">Name</label>
                    <input class="form-control" id="addName" name="Name" required
                           pattern="[A-Za-z0-9_\-]+" placeholder="e.g. POS" />
                    <div class="form-hint">Letters, numbers, underscore, hyphen.</div>
                </div>
                <div class="mb-0">
                    <label class="form-label" for="addDb">Database Hint</label>
                    <input class="form-control" id="addDb" name="DatabaseHint" placeholder="e.g. RND_POS_Sync" />
                    <div class="form-hint">Used as the default database name in the new sync-config.</div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-accent">Add</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
    (function () {
        @if (TempData["SwitchingProduct"] as string == "1")
        {
            <text>
            var url = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["SwitchUrl"] as string ?? Model.SharedAdminUrl));
            setTimeout(function () { window.location.href = url; }, 4000);
            </text>
        }
    })();
</script>
}
