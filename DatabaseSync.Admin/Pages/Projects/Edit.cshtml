@page "{id?}"
@model DatabaseSync.Admin.Pages.Projects.EditModel
@{
    ViewData["Title"] = Model.IsNew ? "Add Project" : "Edit Project";
    var canStart = Model.ServiceStatus.CanStart;
    var canStop = Model.ServiceStatus.CanStop;
    var overviewActive = Model.ActiveTab == "overview";
    var syncDbActive = Model.ActiveTab == "sync-databases";
    var syncResultsActive = Model.ActiveTab == "sync-results";
    var tablesActive = Model.ActiveTab == "tables";
    var historyActive = Model.ActiveTab == "history";
    var syncableCount = Model.ProjectTables.Count(t => t.HasPrimaryKey);
    var selectedCount = Model.TableSelection.SelectedTables?.Count ?? 0;
}

<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

@if (!Model.IsNew)
{
    <div id="syncResultBanner" class="alert d-none" role="alert"></div>

    <ul class="nav nav-tabs project-edit-tabs mb-3" id="projectEditTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <a class="nav-link @(overviewActive ? "active" : null)"
               id="overview-tab"
               asp-page="./Edit"
               asp-route-id="@Model.Input.Id"
               asp-route-tab="overview"
               role="tab"
               aria-controls="overview-pane"
               aria-selected="@(overviewActive ? "true" : "false")">Overview</a>
        </li>
        <li class="nav-item" role="presentation">
            <a class="nav-link @(syncDbActive ? "active" : null)"
               id="sync-databases-tab"
               asp-page="./Edit"
               asp-route-id="@Model.Input.Id"
               asp-route-tab="sync-databases"
               role="tab"
               aria-controls="sync-databases-pane"
               aria-selected="@(syncDbActive ? "true" : "false")">Sync Databases</a>
        </li>
        <li class="nav-item" role="presentation">
            <a class="nav-link @(syncResultsActive ? "active" : null)"
               id="sync-results-tab"
               asp-page="./Edit"
               asp-route-id="@Model.Input.Id"
               asp-route-tab="sync-results"
               role="tab"
               aria-controls="sync-results-pane"
               aria-selected="@(syncResultsActive ? "true" : "false")">Sync Results</a>
        </li>
        <li class="nav-item" role="presentation">
            <a class="nav-link @(tablesActive ? "active" : null)"
               id="tables-tab"
               asp-page="./Edit"
               asp-route-id="@Model.Input.Id"
               asp-route-tab="tables"
               role="tab"
               aria-controls="tables-pane"
               aria-selected="@(tablesActive ? "true" : "false")">Tables</a>
        </li>
        <li class="nav-item" role="presentation">
            <a class="nav-link @(historyActive ? "active" : null)"
               id="history-tab"
               asp-page="./Edit"
               asp-route-id="@Model.Input.Id"
               asp-route-tab="history"
               role="tab"
               aria-controls="history-pane"
               aria-selected="@(historyActive ? "true" : "false")">History and Logs</a>
        </li>
    </ul>

    <div class="tab-content" id="projectEditTabContent">
        <div class="tab-pane fade @(overviewActive ? "show active" : null)"
             id="overview-pane"
             role="tabpanel"
             aria-labelledby="overview-tab"
             tabindex="0">

            <div class="panel mb-3">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                    <div>
                        <h2 class="h5 mb-0">Sync control</h2>
                        <div class="form-hint mb-0">Runs against configured sync connections. Open <strong>Sync Results</strong> to see per-server outcomes.</div>
                        <div id="syncProgressPanel" class="sync-progress mt-3 @(Model.SyncStatus.State == "Running" || Model.SyncStatus.ProgressTotal > 0 ? "" : "d-none")">
                            <div class="d-flex justify-content-between align-items-baseline gap-2 mb-1">
                                <div class="form-hint mb-0">
                                    Progress:
                                    <strong id="syncProgressLabel">@Model.SyncStatus.ProgressCompleted / @Model.SyncStatus.ProgressTotal</strong>
                                    <span id="syncProgressDetail">
                                        @if (!string.IsNullOrWhiteSpace(Model.SyncStatus.CurrentTable))
                                        {
                                            <text>· @Model.SyncStatus.CurrentTargetName: @Model.SyncStatus.CurrentTable</text>
                                        }
                                    </span>
                                </div>
                                <strong id="syncProgressPercent">@Model.SyncStatus.ProgressPercent%</strong>
                            </div>
                            <div class="progress sync-progress-bar" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@Model.SyncStatus.ProgressPercent">
                                <div id="syncProgressBar" class="progress-bar progress-bar-striped @(Model.SyncStatus.State == "Running" ? "progress-bar-animated" : "") @(Model.SyncStatus.State == "Failed" ? "bg-danger" : "")" style="width: @(Model.SyncStatus.ProgressPercent)%"></div>
                            </div>
                        </div>
                    </div>
                    <div class="d-flex gap-2">
                        <form method="post" asp-page-handler="SyncNow" asp-route-id="@Model.Input.Id">
                            <button type="submit" class="btn btn-accent">Sync now</button>
                        </form>
                        <form method="post" asp-page-handler="StartService" asp-route-id="@Model.Input.Id">
                            <button type="submit" class="btn btn-outline-secondary" disabled="@(!canStart)">Run sync service</button>
                        </form>
                        <form method="post" asp-page-handler="StopService" asp-route-id="@Model.Input.Id">
                            <button type="submit" class="btn btn-outline-danger" disabled="@(!canStop)">Stop sync service</button>
                        </form>
                    </div>
                </div>
            </div>

            <div class="panel mb-3">
                <h2 class="h5 mb-3">Project</h2>
                <form method="post" asp-page-handler="SaveProject" class="server-edit-form">
                    <input type="hidden" asp-for="Input.Id" />
                    <div class="server-form-row">
                        <label asp-for="Input.Name" class="server-form-title"></label>
                        <div class="server-form-field">
                            <input asp-for="Input.Name" class="form-control" placeholder="e.g. Billing" />
                            <span asp-validation-for="Input.Name" class="text-danger"></span>
                        </div>
                        <label asp-for="Input.ProjectHint" class="server-form-title"></label>
                        <div class="server-form-field">
                            <input asp-for="Input.ProjectHint" class="form-control" placeholder="Short hint" />
                        </div>
                    </div>
                    <hr class="server-form-gold-line" />
                    <div class="server-form-row">
                        <label asp-for="Input.IsActive" class="server-form-title"></label>
                        <div class="server-form-field server-form-checks">
                            <div class="form-check">
                                <input asp-for="Input.IsActive" class="form-check-input" />
                                <label asp-for="Input.IsActive" class="form-check-label">Active</label>
                            </div>
                            <div class="form-hint mb-0">Unchecked = Inactive</div>
                        </div>
                        <span class="server-form-title"></span>
                        <div class="server-form-field d-flex gap-2">
                            <button type="submit" class="btn btn-accent">Save Project</button>
                            <a class="btn btn-outline-secondary" asp-page="./Index">Back</a>
                        </div>
                    </div>
                    <hr class="server-form-gold-line" />
                </form>
            </div>
        </div>

        <div class="tab-pane fade @(syncDbActive ? "show active" : null)"
             id="sync-databases-pane"
             role="tabpanel"
             aria-labelledby="sync-databases-tab"
             tabindex="0">

            <div class="panel mb-3">
                <div class="d-flex justify-content-between align-items-center mb-3 gap-2 flex-wrap">
                    <div>
                        <h2 class="h5 mb-0">Databases for @Model.Input.Name</h2>
                        <div class="form-hint mb-0">Attached to this project. One Source; others are Targets.</div>
                    </div>
                    <a class="btn btn-accent"
                       asp-page="./Edit"
                       asp-route-id="@Model.Input.Id"
                       asp-route-addDb="true"
                       asp-route-tab="sync-databases">Add DB</a>
                </div>

                <div class="table-responsive mb-3">
                    <table class="table align-middle mb-0">
                        <thead>
                        <tr>
                            <th>Database Name</th>
                            <th>Database Hint</th>
                            <th>Server IP</th>
                            <th>User ID</th>
                            <th>Role</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                        </thead>
                        <tbody>
                        @if (Model.Databases.Count == 0)
                        {
                            <tr>
                                <td colspan="7" class="text-muted">No databases attached yet. Click <strong>Add DB</strong>.</td>
                            </tr>
                        }
                        else
                        {
                            foreach (var db in Model.Databases)
                            {
                                Model.TestStatuses.TryGetValue(db.Id, out var testStatus);
                                <tr>
                                    <td><strong>@db.DatabaseName</strong></td>
                                    <td>@db.DatabaseHint</td>
                                    <td>@db.ServerIp</td>
                                    <td>@(string.IsNullOrWhiteSpace(db.UserId) ? "—" : db.UserId)</td>
                                    <td>
                                        @if (db.IsSource)
                                        {
                                            <span class="badge-main">Source</span>
                                        }
                                        else
                                        {
                                            <span class="badge-target">TARGET</span>
                                        }
                                    </td>
                                    <td>
                                        @if (testStatus is null)
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                        else if (testStatus.IsConnected)
                                        {
                                            <span class="badge-status-ok" title="@testStatus.Detail">Connected</span>
                                        }
                                        else
                                        {
                                            <span class="badge-status-fail" title="@testStatus.Detail">Fail Connection</span>
                                        }
                                    </td>
                                    <td class="text-end text-nowrap">
                                        <a class="btn btn-sm btn-outline-secondary"
                                           asp-page="./Edit"
                                           asp-route-id="@Model.Input.Id"
                                           asp-route-editDb="@db.Id"
                                           asp-route-tab="sync-databases">Edit</a>
                                        <form method="post" asp-page-handler="TestDatabase" class="d-inline">
                                            <input type="hidden" name="projectId" value="@Model.Input.Id" />
                                            <input type="hidden" name="databaseId" value="@db.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-secondary">Test</button>
                                        </form>
                                        <form method="post" asp-page-handler="RemoveDatabase" class="d-inline"
                                              onsubmit="return confirm('Remove database @db.DatabaseName from this project?');">
                                            <input type="hidden" name="projectId" value="@Model.Input.Id" />
                                            <input type="hidden" name="databaseId" value="@db.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger">Remove</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                        </tbody>
                    </table>
                </div>

                @if (Model.ShowDbEditor)
                {
                    <div class="border rounded p-3" style="border-color: var(--gold-line) !important;">
                        <h3 class="h6 mb-3">@(Model.DbInput.Id > 0 ? "Edit DB" : "Add DB") — attach to @Model.Input.Name</h3>
                        <form method="post" asp-page-handler="SaveDatabase" class="server-edit-form">
                            <input type="hidden" asp-for="DbInput.Id" />
                            <input type="hidden" asp-for="DbInput.ProjectId" />

                            <div class="server-form-row">
                                <label asp-for="DbInput.DatabaseName" class="server-form-title"></label>
                                <div class="server-form-field">
                                    <input asp-for="DbInput.DatabaseName" class="form-control" placeholder="e.g. BMSBT" />
                                </div>
                                <label asp-for="DbInput.DatabaseHint" class="server-form-title"></label>
                                <div class="server-form-field">
                                    <input asp-for="DbInput.DatabaseHint" class="form-control" placeholder="SQL database name" />
                                </div>
                            </div>
                            <hr class="server-form-gold-line" />

                            <div class="server-form-row">
                                <label asp-for="DbInput.ServerIp" class="server-form-title"></label>
                                <div class="server-form-field">
                                    <input asp-for="DbInput.ServerIp" class="form-control" placeholder="IP or hostname" />
                                </div>
                                <label asp-for="DbInput.UserId" class="server-form-title"></label>
                                <div class="server-form-field">
                                    <input asp-for="DbInput.UserId" class="form-control" />
                                </div>
                            </div>
                            <hr class="server-form-gold-line" />

                            <div class="server-form-row">
                                <label asp-for="DbInput.Password" class="server-form-title"></label>
                                <div class="server-form-field">
                                    <input asp-for="DbInput.Password" class="form-control" autocomplete="new-password" />
                                    <div class="form-hint">Leave blank when editing to keep existing password.</div>
                                </div>
                                <span class="server-form-title">Options</span>
                                <div class="server-form-field server-form-checks">
                                    <div class="form-check">
                                        <input asp-for="DbInput.IsSource" class="form-check-input" />
                                        <label asp-for="DbInput.IsSource" class="form-check-label"></label>
                                    </div>
                                </div>
                            </div>
                            <hr class="server-form-gold-line" />

                            <div class="server-form-row">
                                <span class="server-form-title">Security</span>
                                <div class="server-form-field server-form-checks">
                                    <div class="form-check">
                                        <input asp-for="DbInput.IntegratedSecurity" class="form-check-input" />
                                        <label asp-for="DbInput.IntegratedSecurity" class="form-check-label"></label>
                                    </div>
                                    <div class="form-check">
                                        <input asp-for="DbInput.Encrypt" class="form-check-input" />
                                        <label asp-for="DbInput.Encrypt" class="form-check-label">Encrypt</label>
                                    </div>
                                </div>
                                <span class="server-form-title">Certificate</span>
                                <div class="server-form-field server-form-checks">
                                    <div class="form-check">
                                        <input asp-for="DbInput.TrustServerCertificate" class="form-check-input" />
                                        <label asp-for="DbInput.TrustServerCertificate" class="form-check-label"></label>
                                    </div>
                                </div>
                            </div>
                            <hr class="server-form-gold-line" />

                            <div class="d-flex gap-2">
                                <button type="submit" class="btn btn-accent">Save DB to Project</button>
                                <a class="btn btn-outline-secondary"
                                   asp-page="./Edit"
                                   asp-route-id="@Model.Input.Id"
                                   asp-route-tab="sync-databases">Cancel</a>
                            </div>
                        </form>
                    </div>
                }
            </div>
        </div>

        <div class="tab-pane fade @(syncResultsActive ? "show active" : null)"
             id="sync-results-pane"
             role="tabpanel"
             aria-labelledby="sync-results-tab"
             tabindex="0">
            <div class="panel mb-3">
                <h2 class="h5 mb-1">Server sync results</h2>
                <div class="form-hint mb-3">Double-click a row to open details. Showing databases attached to @Model.Input.Name.</div>
                <div class="table-responsive">
                    <table class="table mb-0" id="serverResultsTable">
                        <thead>
                        <tr>
                            <th>Server</th>
                            <th>Role</th>
                            <th>IP / Database</th>
                            <th>Result</th>
                        </tr>
                        </thead>
                        <tbody id="serverResultsBody">
                        @if (Model.ProjectSyncResults.Count == 0)
                        {
                            <tr>
                                <td colspan="4" class="text-muted">No databases on this project yet. Add a DB, then Sync now.</td>
                            </tr>
                        }
                        else
                        {
                            foreach (var s in Model.ProjectSyncResults)
                            {
                                <tr class="server-row" style="cursor:pointer;"
                                    data-name="@s.Name"
                                    data-role="@(s.IsMain ? "MAIN" : "TARGET")"
                                    data-server="@s.Server"
                                    data-database="@s.Database"
                                    data-outcome="@s.Outcome"
                                    data-reason="@(s.Reason ?? "")"
                                    data-tables-ok="@s.TablesOk"
                                    data-tables-failed="@s.TablesFailed"
                                    data-connection-id="@s.ConnectionId">
                                    <td>@s.Name</td>
                                    <td>@(s.IsMain ? "MAIN" : "TARGET")</td>
                                    <td>@s.Server / @s.Database</td>
                                    <td>
                                        @if (s.Outcome is "Synced" or "Source" or "Connected")
                                        {
                                            <span class="badge-main">@s.Outcome</span>
                                        }
                                        else
                                        {
                                            <span class="badge-target">@s.Outcome</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="tab-pane fade @(tablesActive ? "show active" : null)"
             id="tables-pane"
             role="tabpanel"
             aria-labelledby="tables-tab"
             tabindex="0">
            <div class="panel mb-3">
                <h2 class="h5 mb-1">Tables to synchronise</h2>
                <div class="form-hint mb-0">
                    Tables are loaded from this project’s Source database
                    @if (Model.SourceDatabase is not null)
                    {
                        <text>
                            (<strong>@(string.IsNullOrWhiteSpace(Model.SourceDatabase.DatabaseHint) ? Model.SourceDatabase.DatabaseName : Model.SourceDatabase.DatabaseHint)</strong>
                            — @Model.SourceDatabase.ServerIp / @Model.SourceDatabase.DatabaseName).
                        </text>
                    }
                    else
                    {
                        <text>(Source not set).</text>
                    }
                    Differential sync needs a primary key to match rows between Source and targets.
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(Model.TablesLoadError))
            {
                <div class="alert alert-warning">@Model.TablesLoadError</div>
            }

            <form method="post" asp-page-handler="SaveTableSelection" asp-route-id="@Model.Input.Id" id="projectTablesForm">
                <div class="panel mb-3">
                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3">
                        <div class="form-check">
                            <input asp-for="TableSelection.SyncAllTables" class="form-check-input" id="syncAllTables" />
                            <label asp-for="TableSelection.SyncAllTables" class="form-check-label" for="syncAllTables">
                                Synchronise all syncable tables (including new tables added later)
                            </label>
                        </div>
                        <div class="d-flex gap-2" id="selectionButtons">
                            <button type="button" class="btn btn-sm btn-outline-secondary" id="btnSelectAll">Select all syncable</button>
                            <button type="button" class="btn btn-sm btn-outline-secondary" id="btnClear">Clear</button>
                        </div>
                    </div>
                    <div class="form-hint mb-0" id="selectionSummary">
                        @if (Model.TableSelection.SyncAllTables)
                        {
                            <text>Mode: <strong>all tables</strong> (@syncableCount syncable of @Model.ProjectTables.Count listed).</text>
                        }
                        else
                        {
                            <text>Mode: <strong>selected only</strong> — <span id="selectedCountText">@selectedCount</span> selected.</text>
                        }
                    </div>
                </div>

                <div class="panel mb-3">
                    @if (Model.ProjectTables.Count == 0 && string.IsNullOrWhiteSpace(Model.TablesLoadError))
                    {
                        <p class="mb-0 text-muted">No user tables found on Source.</p>
                    }
                    else if (Model.ProjectTables.Count > 0)
                    {
                        <div class="table-responsive">
                            <table class="table align-middle mb-0" id="tablesGrid">
                                <thead>
                                <tr>
                                    <th style="width:3rem;"></th>
                                    <th>Schema</th>
                                    <th>Table</th>
                                    <th>Primary key</th>
                                    <th>Skip reason</th>
                                    <th class="text-end">Approx. rows</th>
                                </tr>
                                </thead>
                                <tbody>
                                @foreach (var table in Model.ProjectTables)
                                {
                                    var isChecked = Model.TableSelection.SyncAllTables
                                                    || (Model.TableSelection.SelectedTables?.Contains(table.Key, StringComparer.OrdinalIgnoreCase) ?? false);
                                    <tr class="@(table.HasPrimaryKey ? "" : "table-secondary")">
                                        <td>
                                            @if (table.HasPrimaryKey)
                                            {
                                                <input class="form-check-input table-check"
                                                       type="checkbox"
                                                       name="TableSelection.SelectedTables"
                                                       value="@table.Key"
                                                       @(isChecked ? "checked" : null)
                                                       @(Model.TableSelection.SyncAllTables ? "disabled" : null) />
                                            }
                                            else
                                            {
                                                <input class="form-check-input" type="checkbox" disabled title="No primary key" />
                                            }
                                        </td>
                                        <td>@table.SchemaName</td>
                                        <td><strong>@table.TableName</strong></td>
                                        <td>
                                            @if (table.HasPrimaryKey)
                                            {
                                                <span class="badge-main">Yes</span>
                                            }
                                            else
                                            {
                                                <span class="badge-target">No</span>
                                            }
                                        </td>
                                        <td>
                                            @if (table.HasPrimaryKey)
                                            {
                                                <span class="text-muted">—</span>
                                            }
                                            else
                                            {
                                                <span title="Add a primary key on Source (and the same key on each target) to enable sync.">
                                                    No primary key — sync cannot match insert/update/delete rows
                                                </span>
                                            }
                                        </td>
                                        <td class="text-end">@table.ApproximateRowCount.ToString("N0")</td>
                                    </tr>
                                }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>

                <button type="submit" class="btn btn-accent" @(Model.SourceDatabase is null ? "disabled" : null)>Save table selection</button>
            </form>
        </div>

        <div class="tab-pane fade @(historyActive ? "show active" : null)"
             id="history-pane"
             role="tabpanel"
             aria-labelledby="history-tab"
             tabindex="0">

            <div class="panel mb-3">
                <h2 class="h5 mb-1">Sync failure reasons</h2>
                <div class="form-hint mb-3">Why the latest sync was not successful for databases on @Model.Input.Name.</div>
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead>
                        <tr>
                            <th>Scope</th>
                            <th>Name</th>
                            <th>Outcome</th>
                            <th>Reason</th>
                        </tr>
                        </thead>
                        <tbody>
                        @if (Model.ProjectFailures.Count == 0)
                        {
                            <tr>
                                <td colspan="4" class="text-muted">No failure reasons recorded. Last sync succeeded or has not run yet.</td>
                            </tr>
                        }
                        else
                        {
                            foreach (var f in Model.ProjectFailures)
                            {
                                <tr>
                                    <td>@f.Scope</td>
                                    <td><strong>@f.Name</strong></td>
                                    <td><span class="badge-target">@f.Outcome</span></td>
                                    <td>@f.Reason</td>
                                </tr>
                            }
                        }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="panel mb-3">
                <h2 class="h5 mb-1">Project sync history</h2>
                <div class="form-hint mb-3">Sync runs that include this project’s Source/Target databases.</div>
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead>
                        <tr>
                            <th>When</th>
                            <th>Trigger</th>
                            <th>State</th>
                            <th>Main</th>
                            <th>Tables</th>
                            <th>Rows</th>
                            <th>By</th>
                            <th></th>
                        </tr>
                        </thead>
                        <tbody>
                        @if (Model.ProjectSyncRuns.Count == 0)
                        {
                            <tr>
                                <td colspan="8" class="text-muted">No sync history linked to this project yet.</td>
                            </tr>
                        }
                        else
                        {
                            foreach (var run in Model.ProjectSyncRuns)
                            {
                                <tr>
                                    <td>@run.StartedAtUtc.ToLocalTime().ToString("g")</td>
                                    <td>@run.Trigger</td>
                                    <td>
                                        @if (run.State is "Succeeded")
                                        {
                                            <span class="badge-main">@run.State</span>
                                        }
                                        else
                                        {
                                            <span class="badge-target">@run.State</span>
                                        }
                                    </td>
                                    <td>@(run.MainConnectionName ?? "—")</td>
                                    <td>@run.SuccessfulTables ok / @run.FailedTables fail</td>
                                    <td>+@run.RowsInserted / ~@run.RowsUpdated / -@run.RowsDeleted</td>
                                    <td>@(run.RequestedByUserName ?? "—")</td>
                                    <td class="text-end">
                                        <a class="btn btn-sm btn-outline-secondary"
                                           asp-page="./Edit"
                                           asp-route-id="@Model.Input.Id"
                                           asp-route-tab="history"
                                           asp-route-runId="@run.Id">Details</a>
                                    </td>
                                </tr>
                            }
                        }
                        </tbody>
                    </table>
                </div>
            </div>

            @if (Model.SelectedHistoryRun is not null)
            {
                var run = Model.SelectedHistoryRun;
                <div class="panel mb-3">
                    <h2 class="h5 mb-2">Run #@run.Id details</h2>
                    <div class="form-hint mb-3">@(string.IsNullOrWhiteSpace(run.Message) ? "No message." : run.Message)</div>

                    <h3 class="h6">Servers</h3>
                    <div class="table-responsive mb-3">
                        <table class="table table-sm">
                            <thead>
                            <tr>
                                <th>Name</th>
                                <th>Role</th>
                                <th>Server</th>
                                <th>Outcome</th>
                                <th>Reason</th>
                            </tr>
                            </thead>
                            <tbody>
                            @foreach (var s in run.Servers)
                            {
                                <tr>
                                    <td>@s.Name</td>
                                    <td>@(s.IsMain ? "MAIN" : "TARGET")</td>
                                    <td>@s.Server / @s.DatabaseName</td>
                                    <td>@s.Outcome</td>
                                    <td>@(s.Reason ?? "—")</td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>

                    <h3 class="h6">Failed / skipped tables</h3>
                    <div class="table-responsive">
                        <table class="table table-sm mb-0">
                            <thead>
                            <tr>
                                <th>Table</th>
                                <th>Target</th>
                                <th>Result</th>
                                <th>I/U/D</th>
                                <th>Error</th>
                            </tr>
                            </thead>
                            <tbody>
                            @{
                                var problemTables = run.Tables.Where(t => !t.Success || t.Skipped || !string.IsNullOrWhiteSpace(t.ErrorMessage)).ToList();
                            }
                            @if (problemTables.Count == 0)
                            {
                                <tr><td colspan="5" class="text-muted">No failed tables in this run.</td></tr>
                            }
                            else
                            {
                                foreach (var t in problemTables)
                                {
                                    <tr>
                                        <td>@t.SchemaName.@t.TableName</td>
                                        <td>@(t.TargetConnectionName ?? "—")</td>
                                        <td>@(t.Skipped ? "Skipped" : t.Success ? "OK" : "Failed")</td>
                                        <td>@t.RowsInserted / @t.RowsUpdated / @t.RowsDeleted</td>
                                        <td>@(t.ErrorMessage ?? "—")</td>
                                    </tr>
                                }
                            }
                            </tbody>
                        </table>
                    </div>
                </div>
            }

            <div class="panel mb-3">
                <h2 class="h5 mb-3">Project activity log</h2>
                <div class="table-responsive">
                    <table class="table table-sm mb-0">
                        <thead>
                        <tr>
                            <th>When</th>
                            <th>User</th>
                            <th>Action</th>
                            <th>Detail</th>
                        </tr>
                        </thead>
                        <tbody>
                        @if (Model.ProjectAuditEvents.Count == 0)
                        {
                            <tr><td colspan="4" class="text-muted">No project activity logged yet.</td></tr>
                        }
                        else
                        {
                            foreach (var a in Model.ProjectAuditEvents)
                            {
                                <tr>
                                    <td>@a.CreatedAtUtc.ToLocalTime().ToString("g")</td>
                                    <td>@(a.UserName ?? "—")</td>
                                    <td>@a.Category / @a.Action</td>
                                    <td>@a.Detail</td>
                                </tr>
                            }
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="serverDetailModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h2 class="modal-title h5" id="detailTitle">Server details</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <dl class="row mb-0 detail-list">
                        <dt class="col-sm-4">Server</dt><dd class="col-sm-8" id="detailName"></dd>
                        <dt class="col-sm-4">Role</dt><dd class="col-sm-8" id="detailRole"></dd>
                        <dt class="col-sm-4">IP</dt><dd class="col-sm-8" id="detailServer"></dd>
                        <dt class="col-sm-4">Database</dt><dd class="col-sm-8" id="detailDatabase"></dd>
                        <dt class="col-sm-4">Result</dt><dd class="col-sm-8" id="detailOutcome"></dd>
                        <dt class="col-sm-4">Tables OK</dt><dd class="col-sm-8" id="detailTablesOk"></dd>
                        <dt class="col-sm-4">Tables failed</dt><dd class="col-sm-8" id="detailTablesFailed"></dd>
                        <dt class="col-sm-4">Connection Id</dt><dd class="col-sm-8" id="detailConnectionId"></dd>
                        <dt class="col-sm-4">Reason</dt><dd class="col-sm-8" id="detailReason"></dd>
                    </dl>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="panel mb-3">
        <h2 class="h5 mb-3">Project</h2>
        <form method="post" asp-page-handler="SaveProject" class="server-edit-form">
            <input type="hidden" asp-for="Input.Id" />
            <div class="server-form-row">
                <label asp-for="Input.Name" class="server-form-title"></label>
                <div class="server-form-field">
                    <input asp-for="Input.Name" class="form-control" placeholder="e.g. Billing" />
                    <span asp-validation-for="Input.Name" class="text-danger"></span>
                </div>
                <label asp-for="Input.ProjectHint" class="server-form-title"></label>
                <div class="server-form-field">
                    <input asp-for="Input.ProjectHint" class="form-control" placeholder="Short hint" />
                </div>
            </div>
            <hr class="server-form-gold-line" />
            <div class="server-form-row">
                <label asp-for="Input.IsActive" class="server-form-title"></label>
                <div class="server-form-field server-form-checks">
                    <div class="form-check">
                        <input asp-for="Input.IsActive" class="form-check-input" />
                        <label asp-for="Input.IsActive" class="form-check-label">Active</label>
                    </div>
                    <div class="form-hint mb-0">Unchecked = Inactive</div>
                </div>
                <span class="server-form-title"></span>
                <div class="server-form-field d-flex gap-2">
                    <button type="submit" class="btn btn-accent">Save Project</button>
                    <a class="btn btn-outline-secondary" asp-page="./Index">Back</a>
                </div>
            </div>
            <hr class="server-form-gold-line" />
        </form>
    </div>

    <div class="panel">
        <p class="mb-0 text-muted">Save the project first, then open <strong>Sync Databases</strong> to attach databases.</p>
    </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    @if (!Model.IsNew)
    {
    <script>
    (function () {
        const banner = document.getElementById('syncResultBanner');
        const body = document.getElementById('serverResultsBody');
        const progressPanel = document.getElementById('syncProgressPanel');
        const progressLabel = document.getElementById('syncProgressLabel');
        const progressDetail = document.getElementById('syncProgressDetail');
        const progressPercent = document.getElementById('syncProgressPercent');
        const progressBar = document.getElementById('syncProgressBar');
        const progressTrack = progressBar ? progressBar.parentElement : null;
        const detailModalEl = document.getElementById('serverDetailModal');
        const detailModal = detailModalEl ? new bootstrap.Modal(detailModalEl) : null;
        let notifiedSuccessKey = sessionStorage.getItem('projectSyncSuccessKey') || '';
        let pollTimer = null;
        let serverCache = [];

        function escapeHtml(value) {
            return (value || '').toString()
                .replaceAll('&', '&amp;')
                .replaceAll('<', '&lt;')
                .replaceAll('>', '&gt;')
                .replaceAll('"', '&quot;');
        }

        function openDetail(s) {
            if (!detailModal || !s) return;
            document.getElementById('detailTitle').textContent = s.name || 'Server details';
            document.getElementById('detailName').textContent = s.name || '—';
            document.getElementById('detailRole').textContent = s.isMain ? 'MAIN' : 'TARGET';
            document.getElementById('detailServer').textContent = s.server || '—';
            document.getElementById('detailDatabase').textContent = s.database || '—';
            document.getElementById('detailOutcome').textContent = s.outcome || '—';
            document.getElementById('detailTablesOk').textContent = String(s.tablesOk ?? 0);
            document.getElementById('detailTablesFailed').textContent = String(s.tablesFailed ?? 0);
            document.getElementById('detailConnectionId').textContent = s.connectionId || '—';
            document.getElementById('detailReason').textContent = s.reason || '—';
            detailModal.show();
        }

        function bindRowClicks() {
            body.querySelectorAll('tr.server-row').forEach(row => {
                row.addEventListener('dblclick', () => {
                    openDetail({
                        name: row.dataset.name,
                        isMain: row.dataset.role === 'MAIN',
                        server: row.dataset.server,
                        database: row.dataset.database,
                        outcome: row.dataset.outcome,
                        reason: row.dataset.reason,
                        tablesOk: row.dataset.tablesOk,
                        tablesFailed: row.dataset.tablesFailed,
                        connectionId: row.dataset.connectionId
                    });
                });
            });
        }

        function renderServers(servers) {
            serverCache = servers || [];
            if (!servers || servers.length === 0) {
                body.innerHTML = '<tr><td colspan="4" class="text-muted">No databases on this project yet. Add a DB, then Sync now.</td></tr>';
                return;
            }

            body.innerHTML = servers.map((s, index) => {
                const role = s.isMain ? 'MAIN' : 'TARGET';
                const badgeClass = (s.outcome === 'Synced' || s.outcome === 'Source' || s.outcome === 'Connected')
                    ? 'badge-main' : 'badge-target';
                return `<tr class="server-row" style="cursor:pointer;" data-index="${index}">
                    <td>${escapeHtml(s.name)}</td>
                    <td>${role}</td>
                    <td>${escapeHtml(s.server)} / ${escapeHtml(s.database)}</td>
                    <td><span class="${badgeClass}">${escapeHtml(s.outcome)}</span></td>
                </tr>`;
            }).join('');

            body.querySelectorAll('tr.server-row').forEach(row => {
                row.addEventListener('dblclick', () => {
                    const idx = Number(row.dataset.index);
                    openDetail(serverCache[idx]);
                });
            });
        }

        function renderProgress(status) {
            if (!progressPanel || !progressBar) return;

            const running = status.state === 'Running';
            const total = Number(status.progressTotal || 0);
            const completed = Number(status.progressCompleted || 0);
            const percent = Math.max(0, Math.min(100, Number(status.progressPercent || 0)));
            const show = running || total > 0;

            progressPanel.classList.toggle('d-none', !show);
            progressLabel.textContent = total > 0 ? `${completed} / ${total}` : (running ? 'starting…' : '—');
            progressPercent.textContent = `${percent}%`;
            progressBar.style.width = `${percent}%`;
            progressBar.classList.toggle('progress-bar-animated', running);
            progressBar.classList.toggle('bg-danger', status.state === 'Failed');
            progressBar.classList.toggle('bg-success', status.state === 'Succeeded');
            if (progressTrack) {
                progressTrack.setAttribute('aria-valuenow', String(percent));
            }

            if (status.currentTable) {
                const target = status.currentTargetName ? `${status.currentTargetName}: ` : '';
                progressDetail.textContent = ` · ${target}${status.currentTable}`;
            } else if (running) {
                progressDetail.textContent = ' · working…';
            } else {
                progressDetail.textContent = '';
            }
        }

        function schedulePoll(isRunning) {
            if (pollTimer) clearInterval(pollTimer);
            pollTimer = setInterval(refreshStatus, isRunning ? 1000 : 4000);
        }

        async function refreshStatus() {
            try {
                const response = await fetch('?handler=SyncStatus', { cache: 'no-store' });
                if (!response.ok) return;
                const status = await response.json();

                renderServers(status.servers || []);
                renderProgress(status);
                schedulePoll(status.state === 'Running');

                const key = (status.finishedAtUtc || '') + '|' + (status.state || '');
                if (status.state === 'Succeeded' && key !== notifiedSuccessKey) {
                    banner.className = 'alert alert-success';
                    banner.textContent = 'Sync completed successfully.';
                    banner.classList.remove('d-none');
                    notifiedSuccessKey = key;
                    sessionStorage.setItem('projectSyncSuccessKey', key);
                } else if (status.state === 'Failed' && key !== notifiedSuccessKey) {
                    banner.className = 'alert alert-danger';
                    banner.textContent = status.message || 'Sync failed.';
                    banner.classList.remove('d-none');
                    notifiedSuccessKey = key;
                    sessionStorage.setItem('projectSyncSuccessKey', key);
                } else if (status.state === 'Running') {
                    banner.className = 'alert alert-info';
                    banner.textContent = 'Sync in progress…';
                    banner.classList.remove('d-none');
                } else if (status.state === 'Skipped') {
                    banner.className = 'alert alert-warning';
                    banner.textContent = status.message || 'Sync skipped.';
                    banner.classList.remove('d-none');
                }
            } catch (e) { }
        }

        if (body) {
            bindRowClicks();
            refreshStatus();
            schedulePoll(false);
        }
    })();
    </script>
    @if (tablesActive)
    {
    <script>
    (function () {
        const syncAll = document.getElementById('syncAllTables');
        const form = document.getElementById('projectTablesForm');
        if (!syncAll || !form) return;

        const checks = () => Array.from(document.querySelectorAll('.table-check'));
        const summary = document.getElementById('selectionSummary');
        const buttons = document.getElementById('selectionButtons');

        function updateUi() {
            const all = syncAll.checked;
            checks().forEach(c => {
                c.disabled = all;
                if (all) c.checked = true;
            });
            if (buttons) {
                buttons.style.opacity = all ? '0.45' : '1';
                buttons.style.pointerEvents = all ? 'none' : 'auto';
            }
            const selected = checks().filter(c => c.checked).length;
            if (summary) {
                summary.innerHTML = all
                    ? 'Mode: <strong>all tables</strong> (every syncable table on Source, including new ones).'
                    : 'Mode: <strong>selected only</strong> — <span id="selectedCountText">' + selected + '</span> selected.';
            }
        }

        syncAll.addEventListener('change', updateUi);
        document.getElementById('btnSelectAll')?.addEventListener('click', () => {
            if (syncAll.checked) return;
            checks().forEach(c => c.checked = true);
            updateUi();
        });
        document.getElementById('btnClear')?.addEventListener('click', () => {
            if (syncAll.checked) return;
            checks().forEach(c => c.checked = false);
            updateUi();
        });
        form.addEventListener('change', (e) => {
            if (e.target.classList.contains('table-check')) updateUi();
        });
        form.addEventListener('submit', () => {
            if (syncAll.checked) {
                checks().forEach(c => { c.disabled = true; c.checked = false; });
            }
        });

        updateUi();
    })();
    </script>
    }
    }
}
