@page
@model DatabaseSync.Admin.Pages.SettingsModel
@{
    ViewData["Title"] = "Triggers";
}

<form method="post" id="settingsForm">
    <div class="form-head">
        <div>
            <p class="eyebrow"><partial name="_Icon" model='"triggers"' /> Triggers</p>
            <h1>When a cycle starts</h1>
            <p class="lede">Manual is the Sync now button on the desk. It is always armed. Auto and interval are configured here and stay quiet until you turn them on.</p>
        </div>
        <button type="submit" class="btn-ink">
            <partial name="_Icon" model='"save"' />
            <span>Save settings</span>
        </button>
    </div>

    @if (!Model.OneWaySyncEnabled)
    {
        <div class="alert alert-danger">
            <partial name="_Icon" model='"alert"' />
            <label class="check">
                <input asp-for="Input.RestoreOneWaySync" />
                <span>One-way sync is off, so cycles do nothing. Turn it back on with this save.</span>
            </label>
        </div>
    }

    <section class="plate section" id="auto">
        <div class="plate-head">
            <div>
                <p class="eyebrow"><partial name="_Icon" model='"triggers"' /> 02 · Auto</p>
                <h2>Local times</h2>
                <p class="hint">Each row fires once, in this machine's time zone. Leave the days empty for every day. A cron expression replaces the clock. Occurrences later than the grace window are missed, not replayed. The worker must be running.</p>
            </div>
            <label class="arm">
                <input asp-for="Input.ScheduledSyncEnabled" />
                <span class="arm-ui" aria-hidden="true"></span>
                <span>Auto</span>
            </label>
        </div>

        @if (Model.Input.Schedules.Count == 0)
        {
            <p class="empty">No times yet. Add the hours you want, then save.</p>
        }

        @for (var i = 0; i < Model.Input.Schedules.Count; i++)
        {
            var schedule = Model.Input.Schedules[i];
            <article class="time-row">
                <input type="hidden" asp-for="Input.Schedules[i].Id" />
                <header>
                    <span class="time-index">@((i + 1).ToString("00"))</span>
                    <label class="arm">
                        <input asp-for="Input.Schedules[i].Enabled" />
                        <span class="arm-ui" aria-hidden="true"></span>
                        <span class="hint">On</span>
                    </label>
                    <div class="segment" role="radiogroup" aria-label="How this time is specified">
                        <label>
                            <input class="mode-clock" type="radio" name="Input.Schedules[@i].UseCron" value="false" checked="@(!schedule.UseCron)" />
                            <span><partial name="_Icon" model='"clock"' /> Clock</span>
                        </label>
                        <label>
                            <input class="mode-cron" type="radio" name="Input.Schedules[@i].UseCron" value="true" checked="@schedule.UseCron" />
                            <span><partial name="_Icon" model='"cron"' /> Cron</span>
                        </label>
                    </div>
                    <button type="submit" class="icon-btn danger" asp-page-handler="RemoveSchedule" asp-route-index="@i">
                        <partial name="_Icon" model='"trash"' />
                        <span>Remove</span>
                    </button>
                </header>
                <div class="clock-fields">
                    <div class="clock-line">
                        <div>
                            <label class="line-label" asp-for="Input.Schedules[i].Time">Time</label>
                            <input asp-for="Input.Schedules[i].Time" class="line" placeholder="09:00" />
                        </div>
                        <div class="days">
                            @foreach (var day in SettingsModel.WeekDays)
                            {
                                var selected = (schedule.DaysOfWeek ?? []).Contains(day, StringComparer.OrdinalIgnoreCase);
                                <label class="day">
                                    <input type="checkbox" name="Input.Schedules[@i].DaysOfWeek" value="@day" checked="@selected" />
                                    <span>@day.Substring(0, 3)</span>
                                </label>
                            }
                        </div>
                    </div>
                    <span asp-validation-for="Input.Schedules[i].Time" class="field-validation-error"></span>
                </div>
                <div class="cron-fields">
                    <label class="line-label" asp-for="Input.Schedules[i].Cron">Cron</label>
                    <input asp-for="Input.Schedules[i].Cron" class="line" placeholder="0 9 * * 1-5" />
                    <p class="hint">Five fields, local time. <span class="mono">0 9 * * 1-5</span> is 09:00 on weekdays. Cron replaces the clock and the days.</p>
                    <span asp-validation-for="Input.Schedules[i].Cron" class="field-validation-error"></span>
                </div>
            </article>
        }

        <div class="split-actions" style="margin-top:0.8rem">
            <button type="submit" class="btn-ghost" asp-page-handler="AddSchedule">
                <partial name="_Icon" model='"plus"' />
                <span>Add time</span>
            </button>
        </div>
    </section>

    <section class="plate section interval-plate" id="interval">
        <div class="plate-head">
            <div>
                <p class="eyebrow"><partial name="_Icon" model='"interval"' /> 03 · Interval</p>
                <h2>Every so often</h2>
                <p class="hint">Off unless you arm it. Each cycle hashes every syncable table, so a short interval is expensive. Missed ticks are not caught up. The worker must be running.</p>
            </div>
            <div>
                <span class="stamp">Off by default</span>
                <label class="arm">
                    <input asp-for="Input.IntervalSyncEnabled" />
                    <span class="arm-ui" aria-hidden="true"></span>
                    <span>Arm</span>
                </label>
            </div>
        </div>
        <div class="pair">
            <div>
                <label class="line-label" asp-for="Input.IntervalValue"></label>
                <input asp-for="Input.IntervalValue" class="line" />
                <span asp-validation-for="Input.IntervalValue" class="field-validation-error"></span>
            </div>
            <div>
                <label class="line-label" asp-for="Input.IntervalUnit"></label>
                <select asp-for="Input.IntervalUnit" class="line">
                    <option>Minutes</option>
                    <option>Hours</option>
                    <option>Days</option>
                </select>
                <span asp-validation-for="Input.IntervalUnit" class="field-validation-error"></span>
            </div>
        </div>
    </section>

    <section class="section" id="conflicts">
        <p class="eyebrow"><partial name="_Icon" model='"conflicts"' /> After a conflict</p>
        <h2>What gets kept</h2>
        <p class="lede">Main always wins. A target row is flagged only when it is strictly newer. The row is backed up, then main is applied. Review the copies on the <a asp-page="/Conflicts" class="icon-btn inline-link"><partial name="_Icon" model='"conflicts"' /><span>Conflicts</span></a> page.</p>
        <label class="option">
            <input asp-for="Input.DryRun" />
            <span>
                <strong><partial name="_Icon" model='"dry"' /> Dry run</strong>
                <small>Compute the diff and write review files. Do not change target data.</small>
            </span>
        </label>
        <label class="option">
            <input asp-for="Input.AssumeDifferingRowsConflict" />
            <span>
                <strong><partial name="_Icon" model='"folder"' /> Back up every differing target row</strong>
                <small>Even when the table has no change-timestamp column, or the target is not newer. Off, because it can be large.</small>
            </span>
        </label>
        <label class="option">
            <input asp-for="Input.UseConflictBackupTables" />
            <span>
                <strong><partial name="_Icon" model='"endpoint"' /> Large conflicts go to a backup table</strong>
                <small>Off. Creates <span class="mono">sync.ConflictBackup_*</span> on the target. Otherwise a large set is a JSONL file.</small>
            </span>
        </label>
        <label class="option">
            <input asp-for="Input.WriteConflictLogTable" />
            <span>
                <strong><partial name="_Icon" model='"log"' /> Also write sync.ConflictLog on the target</strong>
                <small>Off. The JSONL log is always written and is what this desk reads.</small>
            </span>
        </label>
        <div class="grid-3" style="margin-top:0.9rem">
            <div>
                <label class="line-label" asp-for="Input.ConflictBackupFolder"></label>
                <input asp-for="Input.ConflictBackupFolder" class="line" />
                <span asp-validation-for="Input.ConflictBackupFolder" class="field-validation-error"></span>
            </div>
            <div>
                <label class="line-label" asp-for="Input.ConflictFileRowThreshold"></label>
                <input asp-for="Input.ConflictFileRowThreshold" class="line" />
            </div>
            <div>
                <label class="line-label" asp-for="Input.ConflictFileMaxMegabytes"></label>
                <input asp-for="Input.ConflictFileMaxMegabytes" class="line" />
            </div>
        </div>
        <div class="field" style="margin-top:0.8rem">
            <label class="line-label" asp-for="Input.ChangeTimestampColumnNames"></label>
            <textarea asp-for="Input.ChangeTimestampColumnNames" class="area" rows="2" placeholder="Leave empty to use ModifiedAt, UpdatedAt, LastModified, ..."></textarea>
            <p class="hint">First matching datetime column wins. Empty uses the built-in name list. rowversion is ignored.</p>
        </div>
    </section>

    <section class="section" id="engine">
        <p class="eyebrow"><partial name="_Icon" model='"engine"' /> Engine</p>
        <h2>Retries and logging</h2>
        <label class="option">
            <input asp-for="Input.EnableDetailedLogging" />
            <span>
                <strong><partial name="_Icon" model='"log"' /> Detailed logging</strong>
                <small>Write extra diagnostic lines for each cycle.</small>
            </span>
        </label>
        <div class="grid-3" style="margin-top:0.9rem">
            <div>
                <label class="line-label" asp-for="Input.RetryIntervalSeconds"></label>
                <input asp-for="Input.RetryIntervalSeconds" class="line" />
            </div>
            <div>
                <label class="line-label" asp-for="Input.MaximumRetryAttempts"></label>
                <input asp-for="Input.MaximumRetryAttempts" class="line" />
            </div>
            <div>
                <label class="line-label" asp-for="Input.CommandTimeoutSeconds"></label>
                <input asp-for="Input.CommandTimeoutSeconds" class="line" />
            </div>
        </div>
    </section>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
